import Flex
import LeanProofs.Flux.Prelude
import LeanProofs.Flux.VC.Wasm2cFrontendAdjustOflags
open Classical
set_option linter.unusedVariables false


namespace F

namespace Wasm2cFrontendAdjustOflagsQualifs

@[qualif]
def EqTrue (a'₀ : Prop) : Prop :=
  a'₀

@[qualif]
def EqFalse (a'₀ : Prop) : Prop :=
  (¬a'₀)

@[qualif]
def EqZero (a'₀ : Int) : Prop :=
  (a'₀ = 0)

@[qualif]
def GtZero (a'₀ : Int) : Prop :=
  (a'₀ > 0)

@[qualif]
def GeZero (a'₀ : Int) : Prop :=
  (a'₀ ≥ 0)

@[qualif]
def LtZero (a'₀ : Int) : Prop :=
  (a'₀ < 0)

@[qualif]
def LeZero (a'₀ : Int) : Prop :=
  (a'₀ ≤ 0)

@[qualif]
def Eq (a'₀ : Int) (a'₁ : Int) : Prop :=
  (a'₀ = a'₁)

@[qualif]
def Gt (a'₀ : Int) (a'₁ : Int) : Prop :=
  (a'₀ > a'₁)

@[qualif]
def Ge (a'₀ : Int) (a'₁ : Int) : Prop :=
  (a'₀ ≥ a'₁)

@[qualif]
def Lt (a'₀ : Int) (a'₁ : Int) : Prop :=
  (a'₀ < a'₁)

@[qualif]
def Le (a'₀ : Int) (a'₁ : Int) : Prop :=
  (a'₀ ≤ a'₁)

@[qualif]
def Le1 (a'₀ : Int) (a'₁ : Int) : Prop :=
  (a'₀ ≤ (a'₁ - 1))

end Wasm2cFrontendAdjustOflagsQualifs

open Wasm2cFrontendAdjustOflagsQualifs

set_option maxHeartbeats 5000000
set_option flex.benchPhases true
#time def Wasm2cFrontendAdjustOflags_proof : Wasm2cFrontendAdjustOflags := by
  unfold Wasm2cFrontendAdjustOflags
  (try zap) ; (try benchSimpStar) ; (try solve)

end F
